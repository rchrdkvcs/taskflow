# Copier ce fichier vers .env avant « docker compose up --build -d ».
# Compose lit .env et transmet uniquement les variables déclarées dans compose.yaml.

# Port publié sur la machine hôte : http://localhost:8080
FRONT_PORT=8080

# API : environnement affiché par /api/info et port interne (Nginx suit ce port).
APP_ENV=production
PORT=3000

# PostgreSQL : identifiants communs à l'API et au service db.
# Remplacer impérativement le mot de passe d'exemple avant le lancement.
# Les valeurs sont utilisées à l'initialisation d'un volume neuf ; modifier .env
# ne change pas les identifiants d'une base déjà créée.
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=change-me-before-running

# Nouvelles tentatives de connexion après la première, et délai en millisecondes.
DB_CONNECT_RETRIES=5
DB_CONNECT_INTERVAL_MS=2000

# Limite de /api/stress, en millisecondes.
STRESS_MAX_MS=5000

# Arrêt propre de l'API (ms). STOP_GRACE_PERIOD est une durée Docker et doit
# dépasser SHUTDOWN_TIMEOUT_MS pour laisser l'API terminer son arrêt.
SHUTDOWN_TIMEOUT_MS=8000
STOP_GRACE_PERIOD=15s

# Variables attendues par l'application mais fixées dans Compose :
# HOST=0.0.0.0      interface d'écoute de l'API dans le conteneur
# DB_HOST=db        nom DNS du service PostgreSQL
# DB_PORT=5432      port PostgreSQL interne ; la base n'est pas publiée sur l'hôte
# NODE_ENV=production
#
# Options hors de cette configuration Compose :
# DB_PASSWORD_FILE=/run/secrets/db_password
#   L'API peut lire le mot de passe dans un fichier (prioritaire sur DB_PASSWORD).
#   Pour l'utiliser, adapter Compose pour monter et transmettre ce secret à
#   l'API et définir POSTGRES_PASSWORD_FILE côté PostgreSQL.
# API_PROXY_TARGET=http://localhost:3000
#   Uniquement pour « npm run dev » dans front/ ; sans effet sur le build Docker.
